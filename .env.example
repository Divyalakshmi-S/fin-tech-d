# Copy this to .env and fill in your values

# --- Supabase (database — auth handled by Streamlit built-in login) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key   # Used by bot & app (bypasses RLS)

# --- Telegram Bot (daily alerts) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Twilio WhatsApp (optional — free $15 credit, lasts ~8 years at 1 msg/day) ---
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH=your_twilio_auth_token
TO_NUMBER=whatsapp:+91XXXXXXXXXX

# --- Weekly email (Gmail: use App Password, not main password) ---
EMAIL_FROM=yourname@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=yourname@gmail.com
EMAIL_SMTP=smtp.gmail.com
EMAIL_PORT=587
